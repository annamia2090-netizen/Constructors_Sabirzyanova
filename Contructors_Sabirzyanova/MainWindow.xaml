<Window x:Class="Contructors_Sabirzyanova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contructors_Sabirzyanova"
        mc:Ignorable="d"
        Title="Студенты КГАПОУ Авиатхеникума" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid Margin="0,0,0,359" >
            <Button Content="Добавить студента" Click="Add_Click" Height="30" Width="130" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
            <Button Content="Изменить запись" Click="Edit_Click" Height="30" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="181,0,0,0"/>
            <Button Content="Удалить запись" Click="Delete_Click" Height="30" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="326,0,0,0"/>
            <Button Content="Сортировать по ФИО" Click="Sort_Click" Height="30" Width="128" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="463,0,0,0"/>

        </Grid>
        <ScrollViewer ScrollChanged="ScrollViewer_ScrollChanged" Margin="0,80,0,0">
            <StackPanel Margin="10" x:Name="parent">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
